# Copy this file to .env. Never commit the resulting .env file.
JOBINATOR_DATABASE_URL=sqlite:///./data/jobinator.db

# Optional for issue #2. Future packet generation will read this value.
JOBINATOR_OPENAI_API_KEY=

# Configure both values to ingest one public Greenhouse job board.
# The token is the board name in https://boards.greenhouse.io/<token>.
JOBINATOR_GREENHOUSE_BOARD_TOKEN=
JOBINATOR_GREENHOUSE_COMPANY=

# Configure both values to ingest one public Lever job site.
# The site is the final segment in https://jobs.lever.co/<site>.
JOBINATOR_LEVER_SITE=
JOBINATOR_LEVER_COMPANY=

# Configure both values to ingest one public Ashby job board.
# The board is the final segment in https://jobs.ashbyhq.com/<board>.
JOBINATOR_ASHBY_BOARD=
JOBINATOR_ASHBY_COMPANY=

# Configure JSON arrays of directly reachable posting URLs. Company career pages
# must expose schema.org JobPosting JSON-LD. Workday URLs must be direct /job/ URLs.
JOBINATOR_CAREER_PAGE_URLS=[]
JOBINATOR_WORKDAY_POSTING_URLS=[]
